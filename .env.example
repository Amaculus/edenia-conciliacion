# Copiá este archivo como .env y completá los valores.

# --- PXSol API pública (para la lista de reservas con check-out) ---
PXSOL_API_KEY=tu_api_key_de_pxsol

# --- Login del PMS (Auth0) para bajar comprobantes y leer los totales reales ---
PXSOL_WEB_USER=tu_usuario@ejemplo.com
PXSOL_WEB_PASS=tu_password

# --- Opcional: IA para leer imágenes de comprobantes que el OCR no puede ---
# Si lo dejás vacío, esos casos quedan como "ilegible" y se revisan a mano.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Tipo de cambio ---
# BCRA da el dólar oficial por fecha; esto es solo el fallback si BCRA no responde.
USD_ARS_RATE=1470
BCRA_USD_ARS_VARIABLE_ID=4
